generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  nama          String
  email         String        @unique
  password      String
  saldo         Int           @default(0)
  tier          String        @default("free")
  expiredAt     DateTime?
  chatCount     Int           @default(0)
  uploadCount   Int           @default(0)
  transactions  Transaction[]
  chats         ChatHistory[]
}

model Transaction {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  type           String   // "deposit" atau "purchase"
  amount         Int
  status         String   @default("success")
  method         String   // QRIS, Saldo, Trakteer
  activationCode String?  // Kode unik kalau beli paket
  isUsed         Boolean  @default(false) // Status kodenya udah dipake atau belum
  createdAt      DateTime @default(now())
}

model ChatHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  sender    String
  message   String
  createdAt DateTime @default(now())
}